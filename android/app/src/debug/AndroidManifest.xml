<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.

         The main manifest declares it too, because the release build needs it
         to reach the API at all. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Cleartext is permitted only for the addresses the debug copy of
             network_security_config.xml names: the three loopback addresses a
             local backend answers on, plus the development machine's LAN API.
             Everything else is still TLS-or-nothing.

             The main source set now carries a config of the same name, and
             resource merging *overrides* rather than merges it, so the debug
             copy is the complete list for a debug build - an address added to
             one file and not the other works in exactly one build type.

             Why the narrowness is worth the duplication: this app carries
             patient data over ward wifi, which is shared, often open, and
             exactly where an attacker sits. A build that trusts cleartext
             generally can be silently read and rewritten in transit — a bed
             state or a triage code changed on the way to the device is a
             clinical event, not a networking one. -->
        <activity android:name=".MainActivity">
            <!-- Lets the screenshot harness drive a route directly:
                   adb shell am start -a android.intent.action.VIEW \
                     -d "medihive://<route>" com.medihive.app
                 Debug-only because a custom scheme is claimable by any app on
                 the device — nothing verifies it the way an App Link is
                 verified — so shipping one invites a look-alike to intercept
                 whatever a link carries. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="medihive"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
