<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Every screen in this app is a view onto the MediHive API. Flutter's
         tooling adds this to the debug and profile manifests for hot reload,
         which is why it was never missed: debug worked and release came back
         with an unexplained network error on every call. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Case-taking lets a patient answer out loud instead of typing, which is
         the difference between a form somebody finishes and one they abandon
         when they are in pain or holding the phone in one hand. This is the
         only permission `record` asks for on any Android this app supports. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- The live voice room, when a site has a media server configured.

         WebRTC puts the device into the communication audio mode and routes
         capture and playback while a call is up, and Android refuses both
         without this. It is a *normal* permission — granted at install, no
         prompt, nothing for a patient to read — so it costs nothing to declare
         and the feature is silently half-broken without it: the room connects,
         the transcripts arrive, and the agent's voice comes out of the earpiece
         at the wrong volume or not at all.

         `flutter_webrtc` declares no permissions of its own, so nothing merges
         this in. RECORD_AUDIO above is the other half and is already here for
         `record`.

         Deliberately **not** BLUETOOTH_CONNECT. A headset would route better
         with it, but on 12 and up it is a runtime permission — a second
         prompt, through a second call site, for a convenience — and
         `media_access.dart` being the only place this app asks a patient for
         anything is worth more than a Bluetooth earpiece. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <!-- Photographing the thing the patient wants looked at: a rash, a
         swelling, the box a medicine came in.

         Declaring CAMERA is not free and is not the obvious choice.
         `image_picker` hands the job to the system camera app, which needs no
         permission at all — but Android's rule is that an app which *declares*
         CAMERA must then be granted it at runtime before ACTION_IMAGE_CAPTURE
         will start, and an app which does not declare it is handed the camera
         with no prompt. Declared on purpose, and asked for through
         `MediaAccess`, so the refusal is a sentence the patient can read
         rather than a picker that opens onto nothing. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Attaching a photo the patient already has, split at the API level
         where Android split it.

         33 and up have per-type media permissions, and the photo picker
         `image_picker` uses on those releases needs none of them — but
         `permission_handler`'s `Permission.photos` maps onto READ_MEDIA_IMAGES
         there, so the declaration is what makes the gate answer honestly
         instead of reporting permanently-denied for a permission the manifest
         never asked for.

         32 and below have only the one coarse permission, hence the ceiling:
         left open-ended it would be requested on releases that have replaced
         it, which is a scary-sounding prompt for nothing. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <!-- `file_picker` needs no storage permission on any of these releases: it
         opens the Storage Access Framework, and a document the user chose in
         the system picker is granted to this app by that choice. Noted because
         the missing line looks like an oversight otherwise. -->

    <application
        android:label="MediHive"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
