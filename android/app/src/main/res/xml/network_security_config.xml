<?xml version="1.0" encoding="utf-8"?>
<!--
  The cleartext policy for every build type.

  The base config keeps the platform default - TLS or nothing - and the
  exception below is the whole of the hole: the LAN address of the development
  machine running `npm run dev`, which serves the API over plain http on 3000.

  There is no wildcard and no private-range entry, so a stray call to any other
  http host still fails. That is deliberate: `192.168.0.0/16` would permit every
  server on whatever Wi-Fi the handset happens to be joined to.

  This file governs release and profile builds. The debug source set has its own
  copy at `src/debug/res/xml/network_security_config.xml`, and Android resource
  merging *overrides* rather than merges a same-named resource, so the debug
  copy must list this address too. Changing the address means changing both
  files and `lib/app/data/network/endpoints.dart`.

  When the demo moves back behind the ngrok tunnel this whole exception can go:
  that origin is https and needs no entry here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.163.97</domain>
    </domain-config>
</network-security-config>
